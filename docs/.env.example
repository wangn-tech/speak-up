# ============================================================
# AI 英语口语陪练平台 — 环境变量模板（v1, 2026-09-10）
# 复制为 .env 后填写真实值；不要把真实密钥提交到仓库
# ============================================================

# ---------- LLM：通义百炼统一入口（通义 + DeepSeek + Embedding 共用）----------
DASHSCOPE_API_KEY=sk-你的百炼key
# 北京地域通用域名（OpenAI 兼容协议）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 业务空间专属域名（推荐后续切换以提升稳定性）：
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 通义千问（对话/评测；旗舰改 qwen3.8-max，省钱改 qwen3.6-flash）
QWEN_CHAT_MODEL=qwen3.7-plus
# DeepSeek（走百炼，无需独立 Key；经济档改 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-pro

# ---------- DeepSeek 官方直连（可选第二供应商，不需要可留空）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DIRECT_MODEL=deepseek-v4-pro

# ---------- Embedding（RAG 向量化，走百炼 /embeddings）----------
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024          # 必须与向量库 collection 维度一致
# 长文本/更省成本可换：qwen3.7-text-embedding-flash（128K 上下文）

# ---------- ASR（阿里云百炼语音识别，共用 DASHSCOPE_API_KEY）----------
ASR_PROVIDER=dashscope
ASR_MODEL_REALTIME=paraformer-realtime-v2   # 实时流式（WebSocket）
ASR_MODEL_OFFLINE=paraformer-v2             # 离线精转（复盘/评测）
ASR_LANGUAGE_HINTS=zh,en                    # 中英文混合识别

# ---------- TTS（阿里云百炼实时语音合成，共用 DASHSCOPE_API_KEY）----------
TTS_PROVIDER=dashscope
# 调研基线为 CosyVoice 系列（cosyvoice-v2）；官方已提供 v3/v3.5 等新版本，
# 接入时以百炼控制台当前可用模型列表为准
TTS_MODEL=cosyvoice-v2
TTS_VOICE=longxiaochun                      # 音色按控制台可选列表调整

# ---------- 向量库（首推 Qdrant，Docker 单节点）----------
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333               # REST（Python/LangChain 用）
QDRANT_GRPC_URL=qdrant:6334                 # gRPC（Go go-client 用）
QDRANT_API_KEY=用openssl-rand生成             # 容器侧映射为 QDRANT__SERVICE__API_KEY
QDRANT_COLLECTION_KB=rag_knowledge          # 知识库 collection
QDRANT_COLLECTION_MEMORY=conv_memory        # 对话记忆 collection
QDRANT_VECTOR_DIM=1024                      # 与 EMBEDDING_DIMENSIONS 一致
QDRANT_DISTANCE=Cosine

# ---------- 可观测性（Prometheus + Grafana，MVP 不引入 ELK）----------
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=请修改
GRAFANA_DATA_SOURCE_URL=http://prometheus:9090
METRICS_ENABLED=true
METRICS_PORT=9091                            # Go 后端 /metrics 端口
PYTHON_METRICS_PORT=9092                     # AI 端 FastAPI /metrics 端口
# 告警（可选，Webhook 推飞书/钉钉）
ALERT_WEBHOOK_URL=

# ---------- 基础设施（Docker Compose 服务地址）----------
MYSQL_DSN=user:pass@tcp(mysql:3306)/esl?charset=utf8mb4&parseTime=True
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092
